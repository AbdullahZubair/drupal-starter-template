# Environment file for the project

APP_ENV=

#Database credentials.
DATABASE=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=3306

# Set the directories for drupal.
CONFIG_SYNC_DIRECTORY=../config/sync
PRIVATE_FILE_DIRECTORY=../private
PUBLIC_FILE_DIRECTORY=files
ASSETS_DIRECTORY=assets
TEMPORARY_DIRECTORY=../temp

#Set the Drupal settings.
HASH_SALT=
SITE_NAME=
SKIP_PERMISSIONS_HARDENING=off
UPDATE_FREE_ACCESS=off
REBUILD_ACCESS=off
TRUSTED_HOST=

#End.
